# ── Solana RPC ──────────────────────────────────────────────────────────────
SOLANA_RPC_URL=https://mainnet.helius-rpc.com/?api-key=your_helius_api_key
SOLANA_WSS_URL=wss://mainnet.helius-rpc.com/?api-key=your_helius_api_key
# Optional: Jito Shredstream for pre-inclusion defense
SHREDSTREAM_URL=wss://mainnet.block-engine.jito.wtf/api/v1/shredstream

# ── EVM RPC ──────────────────────────────────────────────────────────────────
ETH_RPC_URL=https://eth-mainnet.g.alchemy.com/v2/your_alchemy_key
BSC_RPC_URL=https://bsc-dataseed.binance.org/
BASE_RPC_URL=https://mainnet.base.org

# ── Telegram ─────────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_primary_admin_chat_id
# Comma-separated list of admin Telegram user IDs (includes TELEGRAM_CHAT_ID by default)
ADMIN_CHAT_IDS=your_chat_id_here,another_admin_id_here

# ── Security ─────────────────────────────────────────────────────────────────
SAFE_WALLET_ADDRESS=your_safe_solana_wallet_address
SAFE_WALLET_PRIVATE_KEY=your_safe_wallet_private_key_base58
EVM_SAFE_ADDRESS=0x_your_evm_safe_address

# Fernet key for background/static encryption (generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
ENCRYPTION_KEY=your_fernet_key_here

# API key for the REST dashboard — must be set to protect the API
# Generate a secure random value: python -c "import secrets; print(secrets.token_urlsafe(32))"
API_SECRET_KEY=your_secure_api_key_here

# Anthropic API key for AI-driven forensic reports (optional)
# Get one at https://console.anthropic.com
AI_API_KEY=

# Origin of the dashboard frontend (restrict CORS to this URL in production)
DASHBOARD_ORIGIN=http://localhost:3000

# ── Detection Thresholds ─────────────────────────────────────────────────────
DUST_THRESHOLD_SOL=0.00001
DUST_THRESHOLD_ETH=0.0001
RISK_SCORE_THRESHOLD=50

# ── Wallets ───────────────────────────────────────────────────────────────────
# Comma-separated initial watched wallets (can also be added via /add_monitored)
MONITORED_WALLETS=address1,address2
EVM_WALLETS=0x_address1,0x_address2

# ── Optional: All That Node RPC auth ─────────────────────────────────────────
ATN_RPC_KID=your_atn_key_id_here

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_PATH=guardian.db
